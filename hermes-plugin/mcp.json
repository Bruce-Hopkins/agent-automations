{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "leafi": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/dist/server.mjs",
        "--transport",
        "stdio",
        "--no-env"
      ],
      "env": {
        "LEAFI_HOME": "${PLUGIN_DATA}",
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
        "GOOGLE_API_KEY": "${GOOGLE_API_KEY}",
        "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}",
        "LEAFI_EMAIL_ADDRESS": "${LEAFI_EMAIL_ADDRESS}",
        "LEAFI_EMAIL_APP_PASSWORD": "${LEAFI_EMAIL_APP_PASSWORD}",
        "LEAFI_EMAIL_IMAP_HOST": "${LEAFI_EMAIL_IMAP_HOST}",
        "LEAFI_EMAIL_IMAP_PORT": "${LEAFI_EMAIL_IMAP_PORT}",
        "LEAFI_EMAIL_TIMEOUT_MS": "${LEAFI_EMAIL_TIMEOUT_MS}",
        "LEAFI_MCP_COMMAND": "${LEAFI_MCP_COMMAND}",
        "LEAFI_MCP_TOOLS": "${LEAFI_MCP_TOOLS}",
        "LEAFI_MCP_TIMEOUT_MS": "${LEAFI_MCP_TIMEOUT_MS}",
        "LEAFI_ALLOW_BASH": "${LEAFI_ALLOW_BASH}",
        "LEAFI_ALLOW_WRITE": "${LEAFI_ALLOW_WRITE}",
        "LEAFI_ALLOW_WEB": "${LEAFI_ALLOW_WEB}",
        "LEAFI_ALLOW_EMAIL": "${LEAFI_ALLOW_EMAIL}",
        "LEAFI_ALLOW_MCP": "${LEAFI_ALLOW_MCP}",
        "LEAFI_ALLOW_FLOW_PATHS": "${LEAFI_ALLOW_FLOW_PATHS}"
      }
    }
  }
}
